# Copy to .env and fill in. .env is git-ignored; never commit real keys.
# Run exactly ONE uvicorn worker (NiceGUI client state and the realtime hub live in-process).

# Hosted Supabase project URL.
SUPABASE_URL=https://fligjsqzjoyedcuolwss.supabase.co

# Server-side secret key (Dashboard > Project Settings > API Keys). Never expose to a browser.
SUPABASE_SECRET_KEY=sb_secret_...

# Legacy service_role JWT. Set only if Realtime rejects the sb_secret_ key above.
# SUPABASE_REALTIME_KEY=eyJ...

# Signs the NiceGUI session cookie, at least 32 characters. Keep it stable: changing it
# re-prompts every browser for its display name.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
STORAGE_SECRET=

# Public base URL used to build shareable session links.
APP_BASE_URL=http://localhost:8080

# Bind address and port for the local server.
# APP_HOST=127.0.0.1
# APP_PORT=8080

# Startup Realtime connectivity check: strict | warn | off
REALTIME_CHECK=strict

# Tests only: publishable (anon) key, used to prove anonymous access is denied.
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# SUPABASE_DB_PASSWORD is exported in the shell only if `supabase db push` asks for it.
# It never belongs in this file.
